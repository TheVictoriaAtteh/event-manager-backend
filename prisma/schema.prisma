generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(uuid())
  supabaseUserId     String         @unique
  email              String         @unique
  name               String
  avatarUrl          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  role               UserRole       @default(ADMIN)
  checkIns           CheckIn[]
  organizedEvents    Event[]
  uploadedFiles      File[]
  notifications      Notification[]
  ownedOrganizations Organization[]
  assignedTasks      Task[]

  @@map("users")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  logoUrl      String?
  brandColor   String?
  address      String?
  contactEmail String?
  contactPhone String?
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("organizations")
}

model Hall {
  id          String   @id @default(uuid())
  name        String
  address     String?
  description String?
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organizerId String
  events      Event[]

  @@index([organizerId])
  @@map("halls")
}

model Event {
  id                      String         @id @default(uuid())
  description             String
  date                    String
  logoUrl                 String?
  brandColor              String?
  hallId                  String?
  organizerId             String
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  category                String?
  endsAt                  String?
  startsAt                String
  title                   String
  publicRegistrationToken String         @unique @default(uuid())
  attendees               Attendee[]
  ticketTypes             TicketType[]
  paymentOrders           PaymentOrder[]
  hall                    Hall?          @relation(fields: [hallId], references: [id])
  organizer               User           @relation(fields: [organizerId], references: [id])
  tasks                   Task[]

  @@index([organizerId])
  @@index([startsAt])
  @@index([hallId, startsAt, endsAt])
  @@map("events")
}

model Attendee {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phone     String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passes    Pass[]

  @@unique([eventId, email])
  @@index([eventId])
  @@map("attendees")
}

model Pass {
  id                     String                @id @default(uuid())
  attendeeId             String
  ticketTypeId           String?
  paymentOrderId         String?
  paymentOrderAttendeeId String?               @unique
  revokedAt              DateTime?
  createdAt              DateTime              @default(now())
  qrToken                String                @unique
  checkIn                CheckIn?
  attendee               Attendee              @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  ticketType             TicketType?           @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  paymentOrder           PaymentOrder?         @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  paymentOrderAttendee   PaymentOrderAttendee? @relation(fields: [paymentOrderAttendeeId], references: [id], onDelete: SetNull)

  @@index([attendeeId])
  @@index([ticketTypeId])
  @@map("passes")
}

model TicketType {
  id            String         @id @default(uuid())
  eventId       String
  name          String
  description   String?
  priceMinor    Int
  currency      String         @default("NGN")
  quantity      Int?
  reservedCount Int            @default(0)
  soldCount     Int            @default(0)
  isActive      Boolean        @default(true)
  saleStartsAt  DateTime?
  saleEndsAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentOrders PaymentOrder[]
  passes        Pass[]

  @@index([eventId, isActive])
  @@map("ticket_types")
}

model PaymentOrder {
  id                      String                 @id @default(uuid())
  eventId                 String
  ticketTypeId            String
  attendeeName            String
  attendeeEmail           String
  quantity                Int                    @default(1)
  amountMinor             Int
  currency                String
  reference               String                 @unique
  activeCheckoutKey       String?                @unique
  authorizationUrl        String?
  initializationClaimedAt DateTime?
  status                  PaymentStatus          @default(PENDING)
  expiresAt               DateTime
  paidAt                  DateTime?
  emailSentAt             DateTime?
  emailClaimedAt          DateTime?
  refundedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  event                   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType              TicketType             @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  passes                  Pass[]
  attendees               PaymentOrderAttendee[]

  @@index([eventId, attendeeEmail, status])
  @@index([status, expiresAt])
  @@map("payment_orders")
}

model PaymentOrderAttendee {
  id             String       @id @default(uuid())
  paymentOrderId String
  name           String
  email          String
  emailSentAt    DateTime?
  emailClaimedAt DateTime?
  createdAt      DateTime     @default(now())
  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  pass           Pass?

  @@unique([paymentOrderId, email])
  @@index([email])
  @@map("payment_order_attendees")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model CheckIn {
  id          String   @id @default(uuid())
  passId      String   @unique
  scannedById String?
  scannedAt   DateTime @default(now())
  pass        Pass     @relation(fields: [passId], references: [id], onDelete: Cascade)
  scannedBy   User?    @relation(fields: [scannedById], references: [id])

  @@index([scannedAt])
  @@map("check_ins")
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  eventId      String
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User?        @relation(fields: [assignedToId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([assignedToId])
  @@index([status])
  @@map("tasks")
}

model Notification {
  id          String           @id @default(uuid())
  title       String
  message     String
  type        NotificationType @default(GENERAL)
  readAt      DateTime?
  recipientId String
  createdAt   DateTime         @default(now())
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@map("notifications")
}

model File {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@map("files")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  GENERAL
  EVENT
  TASK
  PASS
}

enum UserRole {
  ADMIN
}
