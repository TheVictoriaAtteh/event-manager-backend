# --- Server ---
NODE_ENV=development
PORT=4000

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_manager?schema=public

# --- JWT authentication ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Redis (BullMQ queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# --- Supabase Auth (credentials & email verification) ---
# NEVER commit real values. The service-role key is a server-side secret:
# it must only ever be used by this backend, never in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Frontend (verification-email redirect target) ---
FRONTEND_URL=http://localhost:5173


