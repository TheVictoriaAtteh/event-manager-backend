# =============================================================================
# Event Manager Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and populate with your actual credentials.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=4000

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Neon or any PostgreSQL 14+)
# -----------------------------------------------------------------------------
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/event_manager"

# Optional: Connection-pooled URL (PgBouncer or Neon Serverless)
# Used for high-concurrency environments; if unset, falls back to DATABASE_URL.
DATABASE_URL_POOLED="postgresql://user:password@pooler.host:5432/event_manager?pgbouncer=true"

# -----------------------------------------------------------------------------
# Authentication (Supabase Auth — source of truth for credentials)
# -----------------------------------------------------------------------------
# Your Supabase project URL (e.g., https://abcdefghijk.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# Supabase anon/public key (safe for server-side use in backend API calls)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 🔒 Supabase service-role key (server-side ONLY; NEVER expose to frontend/client)
# Used for admin operations: verifyOtp, getUserById, updateUserPassword
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase JWT secret — used to validate Supabase-issued access tokens server-side.
# Found in: Supabase dashboard → Settings → API → JWT Settings → JWT Secret
# This is the SAME value Supabase uses to sign access tokens for your project.
# It must be set on Railway and any other deployment environment.
# Do NOT generate this yourself — copy it exactly from your Supabase dashboard.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard"

# Frontend URL(s) for CORS and Supabase auth redirects (comma-separated for multiple origins)
# CRITICAL: Set this to your deployed frontend URL on Railway, NOT localhost.
# e.g. FRONTEND_URL="https://your-frontend.up.railway.app"
# For local development: FRONTEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Redis (for BullMQ task queue — optional, queue features disabled if unset)
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
